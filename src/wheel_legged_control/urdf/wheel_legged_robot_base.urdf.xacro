<?xml version="1.0" encoding="utf-8"?>
<robot name="wheel_legged_robot_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 基于原始URDF的简化版本，适配Gazebo -->
  
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0076 0.0067 0.123056" rpy="0 0 0" />
      <mass value="8.8" />
      <inertia ixx="0.326092" ixy="3.6E-05" ixz="-0.00115" iyy="0.229526" iyz="0.006798" izz="0.220537" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.2 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.3 0.2 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- 左前腿第一关节 -->
  <link name="lf0_Link">
    <inertial>
      <origin xyz="0.05976637 -0.00048182 0.01198236" rpy="0 0 0" />
      <mass value="0.16" />
      <inertia ixx="0.00006424" ixy="0.00000030" ixz="0.00012472" iyy="0.00116066" iyz="-0.00000101" izz="0.00117029" />
    </inertial>
    <visual>
      <origin xyz="0.075 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.03 0.02"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.075 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.03 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="lf0_Joint" type="revolute">
    <origin xyz="0.054 0.1705 0.131" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="lf0_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1"/>
    <limit lower="-0.3363" upper="1.3479" effort="30" velocity="10" />
  </joint>

  <!-- 左前腿第二关节 -->
  <link name="lf1_Link">
    <inertial>
      <origin xyz="-0.00032544 0.15899848 0.00798168" rpy="0 0 0" />
      <mass value="0.36" />
      <inertia ixx="0.01248770" ixy="-0.00000383" ixz="-0.00000106" iyy="0.00011869" iyz="0.00042404" izz="0.01251325" />
    </inertial>
    <visual>
      <origin xyz="0 0.125 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.25 0.02"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.125 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.25 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="lf1_Joint" type="revolute">
    <origin xyz="0.15 -0.00010199 0.0205" rpy="0 0 0" />
    <parent link="lf0_Link" />
    <child link="lf1_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1"/>
    <limit lower="-1.0" upper="1.25" effort="30" velocity="10" />
  </joint>

  <!-- 左轮 -->
  <link name="l_wheel_Link">
    <inertial>
      <origin xyz="-0.00004507 -0.00038447 0.02376028" rpy="0 0 0" />
      <mass value="1.22" />
      <inertia ixx="0.00174370" ixy="-0.00000195" ixz="-0.00000028" iyy="0.00176013" iyz="-0.00000241" izz="0.00173973" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.025" radius="0.0675"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.025" radius="0.0675"/>
      </geometry>
    </collision>
  </link>

  <joint name="l_wheel_Joint" type="continuous">
    <origin xyz="1.857E-05 0.25 0.0275" rpy="0 0 0" />
    <parent link="lf1_Link" />
    <child link="l_wheel_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1"/>
    <limit effort="5" velocity="10" />
  </joint>

  <!-- 右前腿第一关节 -->
  <link name="rf0_Link">
    <inertial>
      <origin xyz="0.05976637 -0.00048182 0.01198236" rpy="0 0 0" />
      <mass value="0.16" />
      <inertia ixx="0.00006424" ixy="0.00000174" ixz="0.00012472" iyy="0.00116066" iyz="-0.00000084" izz="0.00117029" />
    </inertial>
    <visual>
      <origin xyz="0.075 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.03 0.02"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.075 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.03 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="rf0_Joint" type="revolute">
    <origin xyz="0.054 -0.1705 0.131" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="rf0_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1"/>
    <limit lower="-1.3479" upper="0.3363" effort="30" velocity="10" />
  </joint>

  <!-- 右前腿第二关节 -->
  <link name="rf1_Link">
    <inertial>
      <origin xyz="0.00032544 -0.15899848 0.00798168" rpy="0 0 0" />
      <mass value="0.36" />
      <inertia ixx="0.01248770" ixy="-0.00000553" ixz="0.00000112" iyy="0.00011869" iyz="-0.00042404" izz="0.01251325" />
    </inertial>
    <visual>
      <origin xyz="0 -0.125 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.25 0.02"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.125 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.25 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="rf1_Joint" type="revolute">
    <origin xyz="0.15 9.5536E-05 0.0205" rpy="0 0 0" />
    <parent link="rf0_Link" />
    <child link="rf1_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1"/>
    <limit lower="-1.25" upper="1.0" effort="30" velocity="10" />
  </joint>

  <!-- 右轮 -->
  <link name="r_wheel_Link">
    <inertial>
      <origin xyz="0.00038403 0.00004865 0.02376028" rpy="0 0 0" />
      <mass value="1.22" />
      <inertia ixx="0.00176009" ixy="-0.00000211" ixz="0.00000241" iyy="0.00174374" iyz="0.00000031" izz="0.00173973" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.025" radius="0.0675"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.025" radius="0.0675"/>
      </geometry>
    </collision>
  </link>

  <joint name="r_wheel_Joint" type="continuous">
    <origin xyz="1.5909E-05 -0.25 0.0275" rpy="0 0 0" />
    <parent link="rf1_Link" />
    <child link="r_wheel_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.1"/>
    <limit effort="5" velocity="10" />
  </joint>

</robot>