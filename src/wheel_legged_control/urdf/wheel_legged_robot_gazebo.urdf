<?xml version="1.0"?>
<robot name="wheel_legged_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 包含基础URDF -->
  <!-- 注意：这里应该直接包含内容而不是使用xacro:include -->
  
  <!-- 材料定义 -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- 基座链接 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.2 0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.2 0.1"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" 
               iyy="0.05" iyz="0.0" 
               izz="0.06"/>
    </inertial>
  </link>

  <!-- IMU链接 -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" 
               iyy="0.0001" iyz="0.0" 
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- IMU关节 -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- 左前腿第一段 -->
  <link name="lf0_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.2"/>
      </geometry>
      <material name="grey"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.2"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
               iyy="0.001" iyz="0.0" 
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- 左前腿第一关节 -->
  <joint name="lf0_Joint" type="revolute">
    <parent link="base_link"/>
    <child link="lf0_link"/>
    <origin xyz="0.1 0.15 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.3363" upper="1.3479" effort="30.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- 左前腿第二段 -->
  <link name="lf1_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.3"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" 
               iyy="0.0015" iyz="0.0" 
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- 左前腿第二关节 -->
  <joint name="lf1_Joint" type="revolute">
    <parent link="lf0_link"/>
    <child link="lf1_link"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0" upper="1.25" effort="30.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- 左轮 -->
  <link name="l_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" 
               iyy="0.002" iyz="0.0" 
               izz="0.0016"/>
    </inertial>
  </link>

  <!-- 左轮关节 -->
  <joint name="l_wheel_Joint" type="continuous">
    <parent link="lf1_link"/>
    <child link="l_wheel_link"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- 右前腿第一段 -->
  <link name="rf0_link">
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.2"/>
      </geometry>
      <material name="grey"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.2"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" 
               iyy="0.001" iyz="0.0" 
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- 右前腿第一关节 -->
  <joint name="rf0_Joint" type="revolute">
    <parent link="base_link"/>
    <child link="rf0_link"/>
    <origin xyz="0.1 -0.15 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.3479" upper="0.3363" effort="30.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- 右前腿第二段 -->
  <link name="rf1_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.3"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" 
               iyy="0.0015" iyz="0.0" 
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- 右前腿第二关节 -->
  <joint name="rf1_Joint" type="revolute">
    <parent link="rf0_link"/>
    <child link="rf1_link"/>
    <origin xyz="0 0 -0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.25" upper="1.0" effort="30.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- 右轮 -->
  <link name="r_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="green"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" 
               iyy="0.002" iyz="0.0" 
               izz="0.0016"/>
    </inertial>
  </link>

  <!-- 右轮关节 -->
  <joint name="r_wheel_Joint" type="continuous">
    <parent link="rf1_link"/>
    <child link="r_wheel_link"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ros2_control配置 -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <!-- 腿部关节 -->
    <joint name="lf0_Joint">
      <command_interface name="position">
        <param name="min">-0.3363</param>
        <param name="max">1.3479</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="lf1_Joint">
      <command_interface name="position">
        <param name="min">-1.0</param>
        <param name="max">1.25</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="rf0_Joint">
      <command_interface name="position">
        <param name="min">-1.3479</param>
        <param name="max">0.3363</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="rf1_Joint">
      <command_interface name="position">
        <param name="min">-1.25</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <!-- 轮子关节 -->
    <joint name="l_wheel_Joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="r_wheel_Joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control插件 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find wheel_legged_control)/config/wheel_legged_control.yaml</parameters>
    </plugin>
  </gazebo>

</robot>