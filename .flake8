[flake8]
# Maximum line length
max-line-length = 127

# Maximum complexity
max-complexity = 10

# Exclude directories
exclude =
    .git,
    __pycache__,
    build,
    dist,
    venv,
    .venv,
    install,
    log,
    .pytest_cache,
    *.egg-info

# Ignore specific errors
ignore =
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator
    W504,  # line break after binary operator

# Select specific error codes to check
select = E,W,F,C

# Show source code for each error
show-source = True

# Show statistics
statistics = True

# Count errors
count = True
